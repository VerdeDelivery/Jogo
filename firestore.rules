rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'capamineiro@gmail.com',
          'mgfpsmiguel@gmail.com'
        ];
    }

    function isBanned(uid) {
      return exists(
        /databases/$(database)/documents/bans/$(uid)
      );
    }

    function validWt() {
      return !('wt' in request.resource.data)
        || (request.resource.data.wt is int
            && request.resource.data.wt >= 0
            && request.resource.data.wt < 86400);
    }

    // ======================= ANTI-CHEAT (servidor) =======================
    // Mude para true SOMENTE enquanto estiver migrando contas do jogo antigo
    // (permite o ranking receber tempo que não veio de uma corrida). Depois volte para false.
    function legacyOpen() { return false; }

    // Relógio do SERVIDOR: runs/{uid}.startedAt é gravado com serverTimestamp quando a corrida começa.
    function runElapsedMs(uid) {
      return request.time.toMillis()
        - get(/databases/$(database)/documents/runs/$(uid)).data.startedAt.toMillis();
    }

    // O tempo (segundos) nunca pode ser maior que o tempo REAL desde o início da corrida (+5 s de folga).
    // Isso anula speed-hack: 1000x de velocidade não consegue "fabricar" tempo.
    function timeOk(uid, secs) {
      return legacyOpen()
        || (exists(/databases/$(database)/documents/runs/$(uid))
            && secs * 1000 <= runElapsedMs(uid) + 5000);
    }

    // wk (semana) não pode estar no futuro; wkt precisa bater com wk * 100000 + wt;
    // pontos (s) com teto. Impede "inventar" posição no ranking semanal.
    function rankShapeOk() {
      let d = request.resource.data;
      return (!('wkt' in d)
              || (d.wk is int && d.wt is int && d.wkt is int
                  && d.wk >= 0 && d.wt >= 0 && d.wt < 86400
                  && d.wkt == d.wk * 100000 + d.wt
                  && d.wk * 604800000 <= request.time.toMillis()))
          && (!('s' in d) || (d.s is int && d.s >= 0 && d.s <= 100000000));
    }

    match /ranking/{uid} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == uid
          && !isBanned(uid)
          && request.resource.data.t is int
          && request.resource.data.t >= 0
          && request.resource.data.t < 86400
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 14
          && validWt()
          && rankShapeOk()
          && (request.resource.data.t == 0 || timeOk(uid, request.resource.data.t))
          && (request.resource.data.get('wt', 0) == 0 || timeOk(uid, request.resource.data.get('wt', 0)))
        );

      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == uid
          && !isBanned(uid)
          && request.resource.data.t is int
          && request.resource.data.t >= 0
          && request.resource.data.t < 86400
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 14
          && request.resource.data.t >= resource.data.t
          && validWt()
          && rankShapeOk()
          && (request.resource.data.t == resource.data.t
              || timeOk(uid, request.resource.data.t))
          && (request.resource.data.get('wt', 0) == resource.data.get('wt', 0)
              || timeOk(uid, request.resource.data.get('wt', 0)))
        );

      allow delete: if false;
    }

    match /profiles/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly([
          'name',
          'avatar',
          'banner',
          'photo',
          'provider',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;

      allow delete: if false;
    }

    match /accountDevices/{uid} {
      allow read: if isAdmin();

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly([
          'accounts',
          'updatedAt'
        ])
        && request.resource.data.accounts is list
        && request.resource.data.accounts.size() <= 100;

      allow delete: if false;
    }

    match /players/{uid} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 14
        && request.resource.data.banned == false
        && request.resource.data.best_no_coin == 0
        && request.resource.data.best_score == 0
        && request.resource.data.wins == 0;

      allow update: if isAdmin()
        || (
          legacyOpen()
          && request.auth != null
          && request.auth.uid == uid
          && !isBanned(uid)
          && request.resource.data.name == resource.data.name
          && request.resource.data.banned == resource.data.banned
          && request.resource.data.best_no_coin is int
          && request.resource.data.best_no_coin >= resource.data.best_no_coin
          && request.resource.data.best_no_coin < 86400
          && request.resource.data.best_score is int
          && request.resource.data.best_score >= resource.data.best_score
          && request.resource.data.wins >= resource.data.wins
        );

      allow delete: if false;
    }

    match /replays/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.frames_json.size() < 200000;
    }

    // Início da corrida (relógio do servidor). Só o dono grava; no máximo 1 vez por segundo.
    match /runs/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time
        && request.time > resource.data.startedAt + duration.value(1, 's');
      allow delete: if false;
    }

    // Relatórios do shield do navegador (cheat detectado). Só o admin lê.
    match /flags/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codes', 'ua', 'n', 'last'])
        && request.resource.data.codes is list
        && request.resource.data.codes.size() <= 80
        && request.resource.data.ua is string
        && request.resource.data.ua.size() <= 160
        && request.resource.data.n is int
        && request.resource.data.n <= 100000;
      allow delete: if isAdmin();
    }

    match /bans/{uid} {
      allow read: if isAdmin()
        || (
          request.auth != null
          && (
            request.auth.uid == uid
            || resource.data.ownerUid == request.auth.uid
          )
        );

      allow create, update, delete: if isAdmin();

      // Banimento automático pelo shield: a conta só consegue banir A SI MESMA, uma vez; só o admin desfaz.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'reason', 'codes', 'at', 'auto', 'code'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.auto == true
        && request.resource.data.reason == 'cheat-automatico'
        && request.resource.data.codes is list
        && request.resource.data.codes.size() <= 20;
    }

    // Banimento por IMPRESSÃO DIGITAL do aparelho (vale mesmo com outra conta ou VPN).
    // Qualquer um pode CONSULTAR o próprio aparelho; só conta logada cria; só o admin edita/apaga/lista.
    match /deviceBans/{fp} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && fp.size() == 32
        && request.resource.data.keys().hasOnly(['reason', 'uid', 'at', 'code'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason == 'cheat-automatico';
      allow update, delete: if isAdmin();
    }

    match /admins/{d} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /live/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquetes: a enquete atual fica em live/poll; cada voto em polls/{id}/votes/{uid}
    match /polls/{pollId}/votes/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid)
        && request.resource.data.keys().hasOnly(['opt', 'at'])
        && request.resource.data.opt is int
        && request.resource.data.opt >= 0
        && request.resource.data.opt < 10
        && get(/databases/$(database)/documents/live/poll).data.id == pollId
        && request.time.toMillis() < get(/databases/$(database)/documents/live/poll).data.endsAt;
      allow update, delete: if false;
    }

    // Multijogador (salas, convites e presença)
    match /mp_lobby/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == uid
        && !isBanned(uid);
    }

    match /mp_rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && !isBanned(request.auth.uid);
      allow update, delete: if request.auth != null
        && resource.data.owner == request.auth.uid;

      match /p/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && !isBanned(uid);
        allow delete: if request.auth != null
          && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/mp_rooms/$(code)).data.owner == request.auth.uid
          );
      }
    }

    match /mp_invites/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && !isBanned(request.auth.uid);
    }

    // Eventos públicos; somente administradores podem gerenciar eventos e recompensas.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Mapas enviados: criador e administradores podem ver rascunhos; mapas publicados são públicos.
    match /mapSubmissions/{mapId} {
      allow read: if isAdmin()
        || (resource.data.status == 'published')
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && !isBanned(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.mapData is map
        && request.resource.data.keys().hasOnly(['title','description','ownerUid','ownerName','mapData','status','createdAt']);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status != 'published'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.status == 'pending'
          && request.resource.data.mapData is map);
      allow delete: if isAdmin();
    }
  }
}
