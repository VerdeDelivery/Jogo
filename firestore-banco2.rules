rules_version = '2';

// BANCO 2 (social): presença online + multijogador.
// Usa o mesmo e-mail/senha do Banco 1 (o jogo cria a conta aqui sozinho no login).
// Ative em Authentication > Método de login > E-mail/senha também neste projeto.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'capamineiro@gmail.com',
          'mgfpsmiguel@gmail.com'
        ];
    }

    match /presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid1', 'name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow delete: if false;
    }

    match /mp_lobby/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /mp_rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /p/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null
          && (
            request.auth.uid == uid
            || get(/databases/$(database)/documents/mp_rooms/$(code)).data.owner == request.auth.uid
          );
      }
    }

    match /mp_invites/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
    }
  }
}
